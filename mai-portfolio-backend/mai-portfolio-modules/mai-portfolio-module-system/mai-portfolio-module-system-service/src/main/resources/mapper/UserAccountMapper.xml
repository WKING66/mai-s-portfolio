<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.amai.portfolio.system.mapper.UserAccountMapper">
    <!-- 资料、密码及访问状态写入锁定同一账号；普通请求鉴权不经过这条查询。 -->
    <select id="selectForUpdate" resultType="dev.amai.portfolio.system.entity.domain.UserAccountDO">
        SELECT id, username, type, password_hash, status, credential_version, created_at, updated_at
        FROM user_account
        WHERE id = #{accountId}
        FOR UPDATE
    </select>
</mapper>
