# PostgreSQL 开发库（固定库名 portfolio_dev）
PSQL_HOST=127.0.0.1
PSQL_PORT=5432
PSQL_USERNAME=portfolio_dev
PSQL_PASSWORD=
OWNER_PASSWORD=

# Redis 3.2.1+；本地开发默认连接本机，密码为空时保持 REDIS_PASSWORD 空值。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=3s
REDIS_COMMAND_TIMEOUT=3s
REDIS_KEY_PREFIX=mai-portfolio
# 仅 test-redis.ps1 临时覆盖为 true；普通启动和回归不要手工开启。
RUN_REDIS_INTEGRATION_TEST=false

# 项目要求 Java 21；仅当系统 JAVA_HOME 不是 Java 21 时填写其安装目录。
JAVA_21_HOME=

# 本地开发默认使用真实私有 OSS；local 仅用于自动化测试或显式离线排障。
MEDIA_STORAGE=oss
MEDIA_LOCAL_DIRECTORY=.local-media

# 切换 MEDIA_STORAGE=oss 时必须填写以下四项；密钥只放实际 .env。
# 必须填写完整 HTTPS 根地址，例如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_CONNECT_TIMEOUT=5s
OSS_SOCKET_TIMEOUT=30s
OSS_MAX_CONNECTIONS=20

# 固定 RSA-2048 私钥：外部 PKCS#8 PEM 文件 URI，禁止提交私钥。
AUTH_RSA_PRIVATE_KEY_LOCATION=

# 注册独立限流：同一客户端默认每 5 分钟最多提交 5 次，不占用登录配额。
# 最大次数必须为正数；窗口支持 Spring Duration 格式（例如 5m）。
PORTFOLIO_SECURITY_MAX_REGISTRATION_ATTEMPTS_PER_CLIENT=5
PORTFOLIO_SECURITY_REGISTRATION_ATTEMPT_WINDOW=5m
