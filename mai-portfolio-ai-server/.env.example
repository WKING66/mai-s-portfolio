APP_ENV=development
# 本地 Docker PostgreSQL 映射到 127.0.0.1:5433，请填独立 AI 数据库名。
# DATABASE_URL=postgresql://<账号>:<密码>@127.0.0.1:5433/mai_portfolio_ai
DATABASE_URL=
AI_DB_SCHEMA=site_guide
AI_EXECUTION_TOKEN=
AI_MANAGEMENT_TOKEN=
WEBSITE_INTERNAL_URL=
WEBSITE_INTERNAL_TOKEN=
MODEL_PROVIDER=
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
MODEL_TIMEOUT_SECONDS=45
CHAT_MAX_OUTPUT_TOKENS=512
AI_DAILY_BUDGET=0
BILLING_CURRENCY=
BILLING_TIME_ZONE=Asia/Shanghai
PRICE_VERSION=
CHAT_INPUT_PRICE_PER_MILLION=
CHAT_OUTPUT_PRICE_PER_MILLION=
EMBEDDING_INPUT_PRICE_PER_MILLION=
# 填写经供应商核实的单次计费输入 Token 上界。
CHAT_BILLABLE_INPUT_LIMIT=
EMBEDDING_BILLABLE_INPUT_LIMIT=
EXECUTION_CONCURRENCY=2
EXECUTION_QUEUE_LIMIT=8
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
MCP_TIMEOUT_SECONDS=5
CONFIG_ENCRYPTION_KEY=
# 模型、定价、单次费用上界和预算均确认后，才允许开启真实调用。
AI_PAID_CALLS_ENABLED=false
