# 本机 Docker PostgreSQL 的独立 AI 数据库，端口为 5433。
# DATABASE_URL=postgresql://<账号>:<密码>@127.0.0.1:5433/mai_portfolio_ai
DATABASE_URL=
# 使用 uv run --locked python -m app.keygen 生成以下启动凭证。
AI_SERVER_TOKEN=
CONFIG_ENCRYPTION_KEY=
# 启用知识功能前应用 0013，并设置 Java 与 Python 共用的内部服务令牌。
# JAVA_BACKEND_BASE_URL=http://127.0.0.1:9333
KNOWLEDGE_SYNC_ENABLED=false
KNOWLEDGE_SYNC_POLL_SECONDS=2
KNOWLEDGE_SYNC_CHAT_THRESHOLD=4
KNOWLEDGE_RAG_ENABLED=false
