# 本机 Docker PostgreSQL 的独立 AI 数据库，端口为 5433。
# DATABASE_URL=postgresql://<账号>:<密码>@127.0.0.1:5433/mai_portfolio_ai
DATABASE_URL=
# 使用 uv run --locked python -m app.keygen 生成以下启动凭证。
AI_SERVER_TOKEN=
CONFIG_ENCRYPTION_KEY=

# Java 内部预算服务地址，仅用于模型外呼前的授权和用量上报。
JAVA_MODEL_BUDGET_URL=http://127.0.0.1:9333/internal/v1/site-guide/budget
