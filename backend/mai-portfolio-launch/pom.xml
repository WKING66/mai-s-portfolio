<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.amai</groupId>
        <artifactId>mai-portfolio</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>mai-portfolio-launch</artifactId>
    <name>mai-portfolio-launch</name>
    <dependencies>
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-module-system-service</artifactId>
        </dependency>
<!--        <dependency>-->
<!--            <groupId>dev.amai</groupId>-->
<!--            <artifactId>mai-portfolio-module-system-provider</artifactId>-->
<!--        </dependency>-->
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-module-portfolio-service</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-module-asset-service</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-module-blog-service</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-module-agent-service</artifactId>
        </dependency>

        <!-- framework starter -->
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-spring-boot-starter-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-spring-boot-starter-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.amai</groupId>
            <artifactId>mai-portfolio-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- Tester -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Launch 回归禁止连接真实 OSS，真实存储由独立集成测试验收。 -->
                        <MEDIA_STORAGE>local</MEDIA_STORAGE>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
