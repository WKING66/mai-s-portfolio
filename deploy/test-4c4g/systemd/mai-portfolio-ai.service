[Unit]
Description=mai-portfolio Python AI service (4c4g test)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=mai-deploy
Group=mai-deploy
WorkingDirectory=/srv/mai-portfolio/current/ai
EnvironmentFile=/srv/mai-portfolio/shared/env/ai.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/mai-portfolio/current/ai/.venv/bin/python -m uvicorn app.main:app_factory --factory --host 127.0.0.1 --port 9344
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/srv/mai-portfolio/shared/logs/ai/stdout.log
StandardError=append:/srv/mai-portfolio/shared/logs/ai/stderr.log

[Install]
WantedBy=multi-user.target
